#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.4.0"
    }
    defaultPrim = "lunabot_2627"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "lunabot_2627"
{
    def Scope "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </lunabot_2627>
            rel physics:body1 = </lunabot_2627/Geometry/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "wheel_front_left_joint" (
            prepend apiSchemas = ["NewtonJointAPI"]
        )
        {
            float newton:velocityLimit = 288.19778
            uniform token physics:axis = "Y"
            rel physics:body0 = </lunabot_2627/Geometry/base_link>
            rel physics:body1 = </lunabot_2627/Geometry/base_link/wheel_front_left>
            point3f physics:localPos0 = (0.260349, 0.270599, -0.00000308838)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:limit:effort = 100
        }

        def PhysicsRevoluteJoint "wheel_front_right_joint" (
            prepend apiSchemas = ["NewtonJointAPI"]
        )
        {
            float newton:velocityLimit = 288.19778
            uniform token physics:axis = "Y"
            rel physics:body0 = </lunabot_2627/Geometry/base_link>
            rel physics:body1 = </lunabot_2627/Geometry/base_link/wheel_front_right>
            point3f physics:localPos0 = (0.260349, -0.270592, -0.00000308838)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:limit:effort = 100
        }

        def PhysicsRevoluteJoint "wheel_rear_left_joint" (
            prepend apiSchemas = ["NewtonJointAPI"]
        )
        {
            float newton:velocityLimit = 288.19778
            uniform token physics:axis = "Y"
            rel physics:body0 = </lunabot_2627/Geometry/base_link>
            rel physics:body1 = </lunabot_2627/Geometry/base_link/wheel_rear_left>
            point3f physics:localPos0 = (-0.260351, 0.270599, -0.00000308838)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:limit:effort = 100
        }

        def PhysicsRevoluteJoint "wheel_rear_right_joint" (
            prepend apiSchemas = ["NewtonJointAPI"]
        )
        {
            float newton:velocityLimit = 288.19778
            uniform token physics:axis = "Y"
            rel physics:body0 = </lunabot_2627/Geometry/base_link>
            rel physics:body1 = </lunabot_2627/Geometry/base_link/wheel_rear_right>
            point3f physics:localPos0 = (-0.260351, -0.270592, -0.00000308838)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:limit:effort = 100
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
        )
        {
            double[] newton:inertia = [2.59173, 6.79596, 6.01457, -0.141812, 1.02352, 0.050353]
            point3f physics:centerOfMass = (0.169762, -0.00404623, 0.177571)
            float3 physics:diagonalInertia = (2.3040051, 6.297049, 6.801206)
            float physics:mass = 54.9041
            quatf physics:principalAxes = (0.6914649, 0.7096115, 0.105816334, -0.08444405)

            over "base_chassis_hull" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "base_hopper_auger_hull" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "base_mining_hull" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "base_drivetrain_hull" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
