            over "base_electronics_hull" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "wheel_front_left" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.00701331, 0.0129399, 0.00701331, -1.77084e-9, 6.74482e-12, 1.97461e-8]
                point3f physics:centerOfMass = (4.73943e-8, 0.000293136, -6.54466e-7)
                float3 physics:diagonalInertia = (0.00701331, 0.00701331, 0.0129399)
