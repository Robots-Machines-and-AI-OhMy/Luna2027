                quatf physics:principalAxes = (-0.27138782, 0.2713867, 0.65295297, 0.65295506)

                over "cylinder" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }
            }

            over "wheel_front_right" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.00701331, 0.0129399, 0.00701331, -1.77084e-9, -6.74482e-12, -1.97461e-8]
                point3f physics:centerOfMass = (-5.58732e-8, -0.000293146, -6.54466e-7)
                float3 physics:diagonalInertia = (0.00701331, 0.00701331, 0.0129399)
                float physics:mass = 1.1957
                quatf physics:principalAxes = (-0.65295297, 0.65295506, 0.27138782, 0.2713867)

                over "cylinder" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
