            }

            over "wheel_rear_left" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.00701331, 0.0129399, 0.00701331, -1.79861e-8, 1.67368e-11, 8.33948e-9]
                point3f physics:centerOfMass = (6.02105e-7, 0.000293136, -2.8163e-7)
                float3 physics:diagonalInertia = (0.00701331, 0.00701331, 0.0129399)
                float physics:mass = 1.1957
                quatf physics:principalAxes = (0.6533679, 0.653368, 0.27039045, -0.2703881)

                over "cylinder" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }
            }

            over "wheel_rear_right" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.00701331, 0.0129399, 0.00701331, -1.79861e-8, -1.67368e-11, -8.33948e-9]
                point3f physics:centerOfMass = (-5.8617e-7, -0.000293146, -2.8163e-7)
                float3 physics:diagonalInertia = (0.00701331, 0.00701331, 0.0129399)
                float physics:mass = 1.1957
                quatf physics:principalAxes = (0.653368, 0.6533679, -0.2703881, 0.27039045)

                over "cylinder" (
