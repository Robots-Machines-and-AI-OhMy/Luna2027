<?xml version="1.0"?>
<robot name="rover">

  <material name="blue">
    <color rgba="0.15 0.35 0.8 1"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.4 0.15"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.6 0.4 0.15"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.12" ixy="0" ixz="0"
               iyy="0.25" iyz="0" izz="0.35"/>
    </inertial>
  </link>

  <link name="front_left_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.00168" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.00168"/>
    </inertial>
  </link>

  <joint name="front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.2 0.23 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.00168" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.00168"/>
    </inertial>
  </link>

  <joint name="front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.2 -0.23 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.00168" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.00168"/>
    </inertial>
  </link>

  <joint name="rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.2 0.23 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.00168" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.00168"/>
    </inertial>
  </link>

  <joint name="rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.2 -0.23 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>
</robot>
